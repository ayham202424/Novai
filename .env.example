# ----- Discord bot -----
# From the Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_GUILD_ID=your-discord-server-id

# Comma-separated list of Discord user IDs allowed to run admin commands.
# Leave empty to rely only on Discord's built-in "Administrator" permission check.
ADMIN_DISCORD_IDS=123456789012345678

# ----- Novai Brain (AI chat) -----
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional override. Google retires the Gemini 2.5 family on 16 Oct 2026 —
# after that, change this to whatever free-tier model Google offers then.
# GEMINI_MODEL=gemini-2.5-flash-lite

# ----- API (used by the Roblox Studio plugin) -----
# Any long random string. Must match API_KEY in the plugin's NovaiApi module.
PLUGIN_API_KEY=change-this-to-a-long-random-string

# Port the HTTP server listens on. Railway sets this automatically in production.
PORT=3000

# ----- Storage -----
# Where license data is stored, as a JSON file.
# Locally this can stay as-is. On Railway, point this at a mounted Volume
# (e.g. /data/db.json) so data survives redeploys.
DB_PATH=./data/db.json
